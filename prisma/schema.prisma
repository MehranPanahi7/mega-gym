generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model admins {
  admin_id     Int                 @id @default(autoincrement())
  user_id      Int                 @unique(map: "user_id")
  admin_note   String?             @db.Text
  admin_status admins_admin_status @default(available)
  admin_phone  String?             @unique(map: "admin_phone") @db.VarChar(20)
  admin_role   admins_admin_role
  admin_email  String              @unique(map: "admin_email") @db.VarChar(50)
  created_at   DateTime            @default(now()) @db.Timestamp(0)
  updated_at   DateTime            @default(now()) @db.Timestamp(0)
  users        users               @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Restrict, map: "admins_ibfk_1")
}

model gym_features {
  gf_id          Int                     @id @default(autoincrement())
  gf_name        String                  @unique(map: "gf_name") @db.VarChar(40)
  gf_gender      gym_features_gf_gender?
  gf_signed_user Int?                    @default(0)
  gf_status      gym_features_gf_status  @default(available)
  created_at     DateTime                @default(now()) @db.Timestamp(0)
  updated_at     DateTime                @default(now()) @db.Timestamp(0)
}

model users {
  user_id          Int                @id @default(autoincrement())
  username         String             @unique(map: "username") @db.VarChar(30)
  user_email       String             @unique(map: "user_email") @db.VarChar(50)
  user_password    String             @db.VarChar(150)
  user_status      users_user_status? @default(disable)
  user_role        users_user_role?   @default(user)
  created_at       DateTime           @default(now()) @db.Timestamp(0)
  updated_at       DateTime           @default(now()) @db.Timestamp(0)
  user_gender      users_user_gender?
  admins           admins?
  email_changes    email_changes[]
  password_changes password_changes[]
  username_changes username_changes[]
}

model password_changes {
  id         Int       @id @default(autoincrement())
  user_id    Int
  changed_at DateTime? @default(now()) @db.DateTime(0)
  users      users     @relation(fields: [user_id], references: [user_id], onUpdate: Restrict, map: "password_changes_ibfk_1")

  @@index([user_id], map: "user_id")
}

model email_changes {
  id         Int      @id @default(autoincrement())
  user_id    Int
  changed_at DateTime @default(now()) @db.DateTime(0)
  users      users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Restrict, map: "email_changes_ibfk_1")

  @@index([user_id], map: "user_id")
}

model username_changes {
  id         Int       @id @default(autoincrement())
  user_id    Int
  changed_at DateTime? @default(now()) @db.DateTime(0)
  users      users     @relation(fields: [user_id], references: [user_id], onUpdate: Restrict, map: "username_changes_ibfk_1")

  @@index([user_id], map: "user_id")
}

enum gym_features_gf_gender {
  male
  female
}

enum admins_admin_status {
  available
  unavailable
}

enum gym_features_gf_status {
  available
  unavailable
}

enum users_user_status {
  active
  disable
}

enum admins_admin_role {
  manager
  coach
  trainer
}

enum users_user_role {
  owner
  admin
  user
}

enum users_user_gender {
  male
  female
}
